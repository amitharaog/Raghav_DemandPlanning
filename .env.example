# Postgres connection string. Locally: any Postgres. In production: the Supabase
# "Connection pooling" URI (Project settings -> Database).
DATABASE_URL=postgres://postgres@localhost:5432/freshroots

# Optional. Without it, reasons fall back to fixed templates (rules still run).
ANTHROPIC_API_KEY=

# Kill switch for the LLM step. Set to "off" to always use template reasons.
LLM_REASONS=on

# Protects the scheduled-run endpoint. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Who the Zoho purchase order is addressed to. "distributor" = the SKU's
# Distributor_Name from sku_master. Replace once procurement confirms vendors.
PO_VENDOR_SOURCE=distributor
