# Postgres connection string. Locally: any Postgres. In production: the Supabase
# connection-pooling URI (Project settings -> Database -> Connection string).
DATABASE_URL=postgres://postgres@localhost:5432/freshroots

# Optional. Without it, reasons fall back to fixed templates (rules still run).
ANTHROPIC_API_KEY=
# Model that writes the reasons. It never sets quantities.
CLAUDE_MODEL=claude-opus-5-5

# AI kill switch. Set to "off" to always use template reasons.
LLM_REASONS=on

# Protects /api/cron. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Basic-auth password for the whole app. Leave empty only on your own laptop.
APP_PASSWORD=
# Name recorded on decisions when there is no basic-auth username.
DEFAULT_USER=raghav

# Pin the run date (YYYY-MM-DD) for scheduled runs, e.g. to replay the seed data.
# Empty = today in IST.
RUN_DATE_OVERRIDE=

# Zoho Inventory API client (api-console.zoho.in). With these set, the Overview shows
# "Connect Zoho"; approved orders can then be sent to Zoho as draft POs.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# ZOHO_ORG_ID=
